{
  "name": "thinking-canvas-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types frontend/tests/foundation.test.mjs",
    "test:python": "python -m unittest discover -s desktop/studio_host/tests -t desktop -v"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.7"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
